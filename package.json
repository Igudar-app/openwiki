{
  "name": "@igudar-app/openwiki",
  "version": "0.4.4",
  "description": "OpenWiki fork by Igudar: a CLI that uses a DeepAgents documentation agent to generate and maintain an OpenWiki for a codebase, with a native DeepSeek provider.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openwiki": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Igudar-app/openwiki.git"
  },
  "bugs": {
    "url": "https://github.com/Igudar-app/openwiki/issues"
  },
  "homepage": "https://github.com/Igudar-app/openwiki#readme",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agents",
    "documentation",
    "wiki",
    "deepagents",
    "langchain",
    "cli",
    "deepseek",
    "igudar"
  ],
  "scripts": {
    "openwiki": "node dist/cli.js",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "changeset:version": "changeset version",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "coverage": "vitest run --coverage",
    "dev": "tsx src/cli.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prebuild": "pnpm run clean",
    "prepack": "pnpm run build",
    "release": "pnpm run stamp:channel && pnpm run build && changeset publish",
    "stamp:channel": "node scripts/stamp-build-channel.cjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.19.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/aws": "^1.5.0",
    "@langchain/core": "^1.3.0",
    "@langchain/google": "^0.2.12",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/openai": "^1.7.1",
    "@langchain/openrouter": "^0.4.19",
    "@langchain/protocol": "^0.0.20",
    "@langchain/tavily": "1.2.0",
    "ci-info": "^4.4.0",
    "cron-parser": "5.10.2",
    "cronstrue": "3.38.0",
    "deepagents": "1.15.1",
    "google-auth-library": "^10.9.0",
    "ink": "^5.1.0",
    "langchain": "^1.5.19",
    "langsmith": "^0.11.1",
    "marked": "^18.1.1",
    "posthog-node": "^5.57.1",
    "react": "^18.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "jsdom": "^29.1.1",
    "mermaid": "^11.16.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "mermaid": "^11.16.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
